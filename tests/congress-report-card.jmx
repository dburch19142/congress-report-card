        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Take the next page from the list">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">SampleResult.setIgnore()
def path = props.get('pageQueue').poll()
if (path == null) {
    ctx.getThread().stop()
} else {
    vars.put('PAGE_PATH', path)
}</stringProp>
        </JSR223Sampler>
        <hashTree/>
