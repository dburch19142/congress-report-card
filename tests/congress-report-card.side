          "targets": [],
          "value": "${senator}"
        },
        {
          "id": "73caed1e-2721-45dd-8d5f-752b4a739514",
          "comment": "",
          "command": "executeScript",
          "target": "const q = document.getElementById('q').value.toLowerCase(); return window.REPORT_DATA.members.filter(m => m.name.toLowerCase().includes(q)).length",
          "targets": [],
          "value": "matches"
        },
        {
          "id": "5306d22f-10a2-4386-9e4d-4bb059d225b6",
          "comment": "",
          "command": "assertText",
          "target": "id=count",
          "targets": [],
