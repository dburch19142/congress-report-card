        },
        {
          "id": "336d285b-18a3-4516-a240-1e30aff74f2c",
          "comment": "",
          "command": "type",
          "target": "id=q",
          "targets": [],
          "value": "Ohio"
        },
        {
          "id": "8ddabe69-e82a-46d2-9f25-6a3e6958c560",
          "comment": "",
          "command": "executeScript",
          "target": "return window.REPORT_DATA.members.filter(m => m.state === 'OH' || m.name.toLowerCase().includes('ohio')).length",
          "targets": [],
          "value": "ohio"
        },
        {
          "id": "e5bed73d-cd29-4b63-8928-7851b9b00888",
          "comment": "",
          "command": "assertText",
          "target": "id=count",
          "targets": [],
