          "command": "executeScript",
          "target": "return window.REPORT_DATA.members.every(m => /^[A-Z]\\d{6}$/.test(m.id) && m.name && m.last && ['House', 'Senate'].includes(m.chamber) && ['Democrat', 'Republican', 'Independent'].includes(m.party) && /^[A-Z]{2}$/.test(m.state))",
