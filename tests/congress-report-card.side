          "comment": "Vote counts are consistent",
          "command": "executeScript",
          "target": "return window.REPORT_DATA.members.every(m => m.votes.eligible >= 0 && m.votes.missed >= 0 && m.votes.missed <= m.votes.eligible && m.votes.eligible <= m.votes.chamberTotal)",
