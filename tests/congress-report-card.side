        },
        {
          "id": "071b3e8f-f97f-47a4-a708-b4ed84630a12",
          "comment": "",
          "command": "executeScript",
          "target": "return [...document.querySelectorAll('#grid .member')].every(e => e.textContent.includes('· OH'))",
          "targets": [],
          "value": "allOhio"
        },
        {
          "id": "71058f00-5f5b-474a-a1ea-b0ebffccacd8",
          "comment": "",
          "command": "assert",
          "target": "allOhio",
          "targets": [],
          "value": "true"
        },
        {
          "id": "850d235c-8624-4e52-81e3-f4a1a2654a19",
          "comment": "",
          "command": "type",
          "target": "id=q",
          "targets": [],
          "value": "zzqqxxnomatch"
        },
        {
          "id": "5285635e-bce4-4d65-b8c4-264478085df9",
          "comment": "Nonsense search returns nothing",
