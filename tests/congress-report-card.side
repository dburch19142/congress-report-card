        {
          "id": "76671ae9-9a03-45e9-9025-9fea7dd45200",
          "comment": "",
          "command": "assertElementNotPresent",
          "target": "css=#grid .member",
          "targets": [],
          "value": ""
        },
        {
          "id": "f109239f-0f8f-41bc-99d0-7f5227905ded",
          "comment": "Clear the search box",
          "command": "runScript",
          "target": "const q = document.getElementById('q'); q.value = ''; q.dispatchEvent(new Event('input'))",
          "targets": [],
          "value": ""
        },
        {
          "id": "8e8e4e7e-10fd-4378-99e9-9c676e58a6a6",
          "comment": "",
          "command": "assertText",
          "target": "id=count",
          "targets": [],
          "value": "${total} of ${total} members"
